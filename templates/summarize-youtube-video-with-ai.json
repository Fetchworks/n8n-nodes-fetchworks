{
  "name": "Summarize a YouTube video with AI",
  "nodes": [
    {
      "parameters": {},
      "id": "5a1e6c8d-0001-4b6e-9c1a-000000000001",
      "name": "When clicking \"Execute workflow\"",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7f2b3c4d-0002-4b6e-9c1a-000000000002",
              "name": "videoUrl",
              "value": "https://www.youtube.com/watch?v=jNQXAC9IVRw",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5a1e6c8d-0003-4b6e-9c1a-000000000003",
      "name": "Set video URL",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "getTranscripts",
        "videoUrls": "={{ $json.videoUrl }}",
        "options": {
          "outputFormats": ["text"]
        }
      },
      "id": "5a1e6c8d-0004-4b6e-9c1a-000000000004",
      "name": "YouTube Transcripts (Fetchworks)",
      "type": "n8n-nodes-fetchworks.fetchworksYoutubeTranscripts",
      "typeVersion": 1,
      "position": [440, 0],
      "credentials": {
        "fetchworksApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Fetchworks API"
        }
      }
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=Summarize this YouTube video transcript in 5 bullet points, then add one line on who should watch it.\n\nTitle: {{ $json.metadata?.title }}\n\nTranscript:\n{{ $json.text }}"
            }
          ]
        },
        "options": {}
      },
      "id": "5a1e6c8d-0005-4b6e-9c1a-000000000005",
      "name": "Summarize with AI",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.8,
      "position": [660, 0],
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "OpenAI API"
        }
      }
    }
  ],
  "connections": {
    "When clicking \"Execute workflow\"": {
      "main": [[{ "node": "Set video URL", "type": "main", "index": 0 }]]
    },
    "Set video URL": {
      "main": [[{ "node": "YouTube Transcripts (Fetchworks)", "type": "main", "index": 0 }]]
    },
    "YouTube Transcripts (Fetchworks)": {
      "main": [[{ "node": "Summarize with AI", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
